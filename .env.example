# Copy this file to .env for local dev and fill in real values.
# In Railway/Render, set these as actual environment variables/secrets instead of a file.
# NEVER commit a filled-in .env to git. This file should only ever contain placeholders.

# --- Supabase Postgres ---
DATABASE_URL=jdbc:postgresql://db.YOUR_PROJECT_REF.supabase.co:5432/postgres
DATABASE_USER=postgres
DATABASE_PASSWORD=your-db-password

# --- Firebase Admin (from the service account JSON — do NOT commit the JSON file) ---
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_ID=your-firebase-client-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-firebase-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY_ID=your-private-key-id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# --- Our own JWT signing ---
JWT_SECRET=change-this-to-a-long-random-string
JWT_ACCESS_TOKEN_EXPIRY_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRY_DAYS=30
JWT_ISSUER=wellness-app-backend
JWT_AUDIENCE=wellness-app-users

# --- Server ---
PORT=8080
